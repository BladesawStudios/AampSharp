<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AampSharp</RootNamespace>
    <AssemblyName>AampSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Reader/Writer for AAMP parameter archives used by Breath of the Wild and Tears of the Kingdom.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="BotwNames.txt" LogicalName="AampSharp.BotwNames.txt" />
    <EmbeddedResource Include="TotkNames.txt" LogicalName="AampSharp.TotkNames.txt" />
  </ItemGroup>

</Project>